<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.afzal.endoscope.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/no_camera"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/status_text"
            style="@style/OverlayText"
            android:text="@string/status_disconnected" />

        <TextView
            android:id="@+id/recording_text"
            style="@style/OverlayText"
            android:layout_marginTop="4dp"
            android:textColor="#FFFF5252"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stream_text"
            style="@style/OverlayText"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/OverlayText"
                android:text="@string/zoom" />

            <SeekBar
                android:id="@+id/zoom_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/rotate_button"
                    style="@style/ToolButton"
                    android:text="@string/rotate" />

                <Button
                    android:id="@+id/mirror_button"
                    style="@style/ToolButton"
                    android:text="@string/mirror" />

                <Button
                    android:id="@+id/flip_button"
                    style="@style/ToolButton"
                    android:text="@string/flip" />

                <Button
                    android:id="@+id/reset_button"
                    style="@style/ToolButton"
                    android:text="@string/reset" />

                <Button
                    android:id="@+id/lens_button"
                    style="@style/ToolButton"
                    android:text="@string/lens_button" />

                <Button
                    android:id="@+id/stream_button"
                    style="@style/ToolButton"
                    android:text="@string/stream" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/last_button"
                style="@style/ToolButton"
                android:layout_marginEnd="32dp"
                android:enabled="false"
                android:text="@string/last" />

            <Button
                android:id="@+id/photo_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/shutter_button"
                android:contentDescription="@string/photo"
                android:text="@string/photo"
                android:textAllCaps="false"
                android:textColor="#FF000000"
                android:textSize="12sp" />

            <Button
                android:id="@+id/record_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/record_button"
                android:text="@string/record"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
